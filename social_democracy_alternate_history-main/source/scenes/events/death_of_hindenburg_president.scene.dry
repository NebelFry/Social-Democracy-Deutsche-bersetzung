on-arrival: dvp_candidate = spd_candidate
go-to: r1_menu if round = 0; r2_campaigning if round > 0
max-visits: 1

[? if dvp_candidate = spd_candidate: Dank unserer guten Beziehungen konnte die DVP dazu bewegt werden, [+ spd_candidate +] zu unterstützen! ?]

@convince_dvp_unity
title: Überzeugen wir die DVP, [+ spd_candidate +] zu unterstützen.
unavailable-subtitle: Die DVP ist nicht bereit, unseren Kandidaten zu unterstützen.
