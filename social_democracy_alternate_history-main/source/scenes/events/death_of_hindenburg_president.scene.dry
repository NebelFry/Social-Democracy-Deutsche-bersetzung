@r2_start
on-arrival: {!
// 1. coordination between the right/far-right
if (Q.Hitler_votes && Q.Seldte_votes) {
    if (Q.Hitler_votes > Q.Seldte_votes) {
        Q.dnvp_candidate = "Hitler";
        Q.other_candidate = "Hitler";
        Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
        if (Q.z_candidate == "Adenauer") {
            Q.Adenauer_bonus = (Q.Adenauer_bonus || 0) + 0.25*Q.other_votes;
        }
    } else {
        Q.nsdap_candidate = "Seldte";
    }
} else if (Q.Goring_votes && Q.Seldte_votes) {
    if (Q.Goring_votes > Q.Seldte_votes) {
        Q.dnvp_candidate = "Göring";
        Q.other_candidate = "Göring";
    } else {
        Q.nsdap_candidate = "Seldte";
    }
}
// 2. If Adenauer & Gessler are both running and neither are part of the SPD coalition, the smaller of these drops out.
Q.adenauer_drops_out = 0;
Q.gessler_drops_out = 0;
if (Q.z_candidate == "Adenauer" && (Q.ddp_candidate == "Gessler" || Q.dvp_candidate == "Gessler") && Q.z_candidate != Q.spd_candidate && (Q.ddp_candidate != Q.spd_candidate || Q.dvp_candidate != Q.spd_candidate)) {
    if (Q.Adenauer_votes > Q.Gessler_votes) {
        Q.gessler_drops_out = 1;
        if (Q.ddp_candidate != Q.spd_candidate) {
            Q.ddp_candidate = "Adenauer";
        }
        if (Q.dvp_candidate != Q.spd_candidate) {
            Q.dvp_candidate = "Adenauer";
        }
        Q.Adenauer_bonus = (Q.Adenauer_bonus || 0) + 0.25*Q.other_votes;
    } else {
        Q.adenauer_drops_out = 1;
        Q.z_candidate = "Gessler";
        Q.Gessler_bonus = 0.25*Q.other_votes;
    }
    if (Q.nsdap_candidate == 'Seldte') {
        Q.Seldte_bonus = (Q.Seldte_bonus || 0) - 0.25*Q.other_votes;
    } else if (Q.nsdap_candidate == "Hitler") {
        Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
    }
}
// DVP drops out to favor the center candidate
if (Q.dvp_candidate != Q.spd_candidate && Q.dvp_candidate != Q.ddp_candidate && Q.dvp_candidate != Q.z_candidate) {
}
!}
go-to: r2_menu

In Führung liegt [+ winner_desc +]. Im ersten Wahlgang gibt es keine Mehrheit. Im zweiten Wahlgang gewinnt derjenige Kandidat, der die meisten Stimmen (eine relative Mehrheit) auf sich vereint.

[? if dnvp_candidate = "Hitler" : DNVP und NSDAP haben ihre Wahlkampfaktivitäten gebündelt, wobei die DNVP nun Hitler für die Stichwahl unterstützt. Manche Wähler aus dem rechten Lager stehen dieser Absprache skeptisch gegenüber und könnten der Wahl fernbleiben. ?]
[? if dnvp_candidate = "Göring" : DNVP und NSDAP haben ihre Wahlkampfaktivitäten gebündelt, wobei die DNVP nun Göring für den zweiten Wahlgang unterstützt. ?]
[? if nsdap_candidate = "Seldte" : DNVP und NSDAP haben ihre Wahlkampfaktivitäten gebündelt, wobei die NSDAP nun Seldte für den zweiten Wahlgang unterstützt. ?]

[? if gessler_drops_out : Der liberale Kandidat Otto Gessler hat seine Kandidatur zugunsten von Konrad Adenauer von der Zentrumspartei zurückgezogen. Dies bündelt die Stimmen des gemäßigten „Bürgerblocks“ und zieht zudem einige Stimmen von kleineren rechten Parteien an. ?]
[? if adenauer_drops_out : Der Kandidat der Zentrumspartei, Konrad Adenauer, hat seine Kandidatur zugunsten des DStP-DVP-Kandidaten Otto Gessler zurückgezogen. Dies bündelt die Stimmen des gemäßigten „Bürgerblocks“ und zieht zudem einige Stimmen von kleineren rechten Parteien an. ?]

