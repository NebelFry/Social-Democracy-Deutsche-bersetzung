= Gustav Radbruch

Gustav Radbruch ist ein renommierter Rechtsgelehrter und langjähriger SPD-Justizminister.


- @judiciary_
- @constitutional_reform_
- @root: Zurück


@judiciary_
title: Justizangelegenheiten
subtitle: Justizreformen durchführen.
choose-if: advisor_action_timer = 0 and spd_in_government and justice_minister_party = "SPD"
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] Monate bis zur nächsten Berateraktion. ?][? if not spd_in_government : Die SPD ist derzeit nicht an der Regierung beteiligt. ?][? if justice_minister_party != "SPD" : Wir haben nicht das Justizministerium . ?]
on-arrival: advisor_action_timer = 6; judiciary_timer -= 6; last_advisor_action = 1
go-to: judiciary


@constitutional_reform_
title: Verfassungsreform
subtitle: Reformen der unzureichenden Weimarer Verfassung durchführen.
choose-if: advisor_action_timer = 0 and spd_in_government and justice_minister_party = "SPD" and ((in_weimar_coalition) or (in_spd_majority) or (in_left_front) or (in_popular_front)) and judicial_reform >= 2
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] Monate bis zur nächsten Berateraktion. ?][? if not spd_in_government : Die SPD ist derzeit nicht an der Regierung beteiligt. ?] [? if justice_minister_party != "SPD" : Wir haben nicht das Justizministerium. ?] [? if judicial_reform < 2: Es ist unwahrscheinlich, dass die Justiz progressive Verfassungsänderungen tolerieren wird. ?] [? if not ((in_weimar_coalition) or (in_spd_majority) or (in_left_front) or (in_popular_front)) : Unsere derzeitige Regierungskoalition wird keine Verfassungsreformen unterstützen. ?]
on-arrival: advisor_action_timer = 6; last_advisor_action = 1; constitutional_reform_timer -= 12
go-to: constitutional_reform

