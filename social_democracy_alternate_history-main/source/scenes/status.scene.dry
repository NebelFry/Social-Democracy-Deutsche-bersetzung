# 1928: 10, 1930: 13
{!<span class="tooltip-text" title="Kommunistische Partei Deutschlands">KPD</span>!}: [+ kpd_r +]%
# 1928: 5, 1930: 4 (as DstP)
{!<span class="tooltip-text" title="Deutsche Demokratische Partei">!}[? if not ddp_name: DDP?][? if ddp_name != 0 : [+ ddp_name +]?]{!</span>!}: [+ ddp_r +]%
# 1928: 9, 1930: 5
{!<span class="tooltip-text" title="Deutsche Volkspartei">DVP</span>!}: [+ dvp_r +]%
# 1928: 14, 1930: 7
{!<span class="tooltip-text" title="Deutschnationale Volkspartei">DNVP</span>!}: [+ dnvp_r +]%
# 1928: 3, 1930: 18
{!<span class="tooltip-text" title="Nationalsozialistische Deutsche Arbeiterpartei(Nazis)">NSDAP</span>!}: [+ nsdap_r +]%
# 1928: 9, 1930: 10
Sonstige: [+ other_r +]%

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

Nächste Wahl: [+ next_election_month : month +] [+ next_election_year +]

= Wirtschaft

Inflation: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : Arbeitslosigkeit: [+ unemployed_2 +]% ?]

Wirtschaftswachstum: [+ economic_growth_2 +]%



