Loyalität der preußischen Polizei: [+ prussian_police_loyalty : loyalty +]

[? if spd_in_government : Loyalität der Polizei: [+ interior_police_loyalty : loyalty +] ?]

@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}

